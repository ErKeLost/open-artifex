{
  "name": "open-artifex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop work and coding agent",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:mastra": "mastra dev",
    "icons": "node scripts/generate-icons.mjs",
    "build": "bun run icons && bun run build:agent-sidecar && tauri build",
    "build:renderer": "vite build",
    "build:agent-sidecar": "bun run scripts/build-agent-sidecar.mjs",
    "build:mastra": "mastra build",
    "package": "bun run icons && bun run build:agent-sidecar && tauri build",
    "make": "bun run icons && bun run build:agent-sidecar && tauri build",
    "start": "tauri dev",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/agent/improvement/*.test.js src/renderer/features/timeline/*.test.js"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.93",
