    "@mastra/core": "^1.63.2",
    "@mastra/libsql": "^1.22.2",
    "@mastra/memory": "^1.28.1",
    "@mastra/observability": "1.17.5",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.3.6",
    "@radix-ui/react-collapsible": "^1.1.20",
