    "@wterm/dom": "^0.3.4",
    "@wterm/react": "^0.3.4",
    "ai": "^7.0.90",
    "chromium-bidi": "11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
